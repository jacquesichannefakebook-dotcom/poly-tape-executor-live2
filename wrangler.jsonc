{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poly-tape-executor-live",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-20",
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poly-tape-executor-live"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "POLY_TAPE_LIVE_ENABLED": "true",
    "POLY_TAPE_OWNER_EMAIL": "owner@poly-tape.local"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
